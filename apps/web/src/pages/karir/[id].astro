---
import Layout from '../../layouts/Layout.astro';
import { JOB_OPENINGS } from '../../constants.tsx';
import type { JobOpening } from '../../types.ts';

export function getStaticPaths() {
  return JOB_OPENINGS.map((job) => ({
    params: { id: job.id },
    props: { job },
  }));
}

const { job } = Astro.props as { job: JobOpening };
const otherJobs = JOB_OPENINGS.filter((j) => j.id !== job.id);
---

<Layout title={`Lowongan Kerja: ${job.title}`} description={job.description.summary}>
  <section class="relative flex items-center bg-[#0E2207] text-white pt-32 pb-16 sm:pt-36 sm:pb-20 lg:pt-48 lg:pb-32 px-4 sm:px-6 lg:px-8">
    <div class="absolute inset-0">
      <img
        src="https://framerusercontent.com/images/qQ7rFB5eVVBjturZ7t2PLrcFLI.jpg"
        alt="Latar Belakang Karir"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0e2207] to-transparent opacity-90"></div>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto">
      <div class="max-w-4xl text-left">
        <span class="inline-block py-2 px-4 border border-[#FBC91A] rounded-full text-sm font-semibold text-[#FBC91A] mb-4">
          Lowongan Pekerjaan
        </span>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-semibold leading-tight tracking-tighter">
          {job.title}
        </h1>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-10 lg:gap-16">
      <div class="lg:w-2/3">
        <article>
          <h2 class="text-3xl font-bold text-[#0E2207] mb-4">Deskripsi Pekerjaan</h2>
          <p class="text-lg text-gray-600 mb-8">{job.description.summary}</p>

          <h2 class="text-3xl font-bold text-[#0E2207] mb-6">Kualifikasi</h2>
          <ul class="space-y-4">
            {job.description.qualifications.map((qual) => (
              <li class="flex items-start gap-3">
                <svg class="h-6 w-6 text-[#1f6306] flex-shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-lg text-gray-700">{qual}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <aside class="lg:w-1/3">
        <div class="sticky top-28 space-y-8">
          <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
            <h3 class="text-2xl font-bold text-[#0e2207] mb-6">Ringkasan Pekerjaan</h3>
            <div class="space-y-4 text-lg">
              <div class="flex flex-col sm:flex-row sm:justify-between">
                <span class="font-semibold text-gray-600">Lokasi:</span>
                <span class="text-left sm:text-right">{job.location}</span>
              </div>
              <div class="flex justify-between">
                <span class="font-semibold text-gray-600">Tipe:</span>
                <span class="text-right">{job.type}</span>
              </div>
            </div>
            <div class="mt-8">
              {job.applicationMethod === 'email' && job.applicationEmail ? (
                <a
                  href={`mailto:${job.applicationEmail}?subject=Lamaran%20Pekerjaan:%20${encodeURIComponent(job.title)}`}
                  class="w-full text-center bg-[#1f6306] text-white font-bold py-3 px-6 rounded-full hover:bg-[#0e2207] transition-colors block"
                >
                  Lamar via Email
                </a>
              ) : (
                <a
                  href={`/karir/${job.id}/apply`}
                  class="w-full text-center bg-[#1f6306] text-white font-bold py-3 px-6 rounded-full hover:bg-[#0e2207] transition-colors block"
                >
                  Lamar Sekarang
                </a>
              )}
            </div>
          </div>

          {otherJobs.length > 0 && (
            <div class="bg-[#0e2207] rounded-2xl p-6">
              <h3 class="text-2xl font-bold text-white mb-6">Lowongan Lainnya</h3>
              <div class="space-y-4">
                {otherJobs.map((otherJob) => (
                  <a
                    href={`/karir/${otherJob.id}`}
                    class="block text-white hover:text-[#fbc91a] font-semibold transition-colors"
                  >
                    {otherJob.title}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </section>
</Layout>
