---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan.">
  <section class="bg-[#0E2207] text-white pt-40 pb-20 sm:pt-48 sm:pb-32 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <span class="inline-block py-2 px-4 border border-[#fbc91a] rounded-full text-sm font-semibold text-[#fbc91a] mb-6">
        404
      </span>
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tighter mb-6">Halaman Tidak Ditemukan</h1>
      <p class="text-lg text-gray-300 mb-8">
        Halaman yang Anda cari mungkin telah dipindahkan atau tidak tersedia lagi.
      </p>
      <a
        href="/"
        class="inline-block bg-[#1f6306] text-white font-bold py-4 px-8 rounded-full hover:bg-white hover:text-[#1f6306] transition-colors"
      >
        Kembali ke Beranda
      </a>
    </div>
  </section>
</Layout>
