---
import Layout from '../../layouts/Layout.astro';
import MarketplaceView from '../../components/marketplace/MarketplaceView';
import { getMarketplaceProducts } from '../../lib/catalog-service.ts';

const products = await getMarketplaceProducts();
---

<Layout
  title="Marketplace Barang & Komoditas Perikanan B2B"
  description="Katalog pasokan komoditas dan barang perikanan FisheryTrade untuk pasar horeka dan grosir lokal dengan transparansi harga terbuka per kg dan stok fisik langsung dari gudang distribusi Muara Baru, Brondong, dan Benoa."
>
  <MarketplaceView client:load products={products} />
</Layout>
