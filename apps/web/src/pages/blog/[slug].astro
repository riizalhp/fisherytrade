---
import Layout from '../../layouts/Layout.astro';
import { BLOG_POSTS } from '../../constants.tsx';
import type { BlogPost } from '../../types.ts';

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.href },
    props: { post },
  }));
}

const { post: blog } = Astro.props as { post: BlogPost };
const otherBlogs = BLOG_POSTS.filter((p) => p.href !== blog.href).slice(0, 4);
---

<Layout
  title={blog.title}
  description={`${blog.title} - Baca selengkapnya di blog PT. Triagro Hijrah Jaya.`}
  image={blog.imageUrl}
  type="article"
>
  <section class="relative flex items-center bg-[#0E2207] text-white pt-32 pb-16 sm:pt-36 sm:pb-20 lg:pt-48 lg:pb-32 px-4 sm:px-6 lg:px-8">
    <div class="absolute inset-0">
      <img
        src="https://framerusercontent.com/images/qQ7rFB5eVVBjturZ7t2PLrcFLI.jpg"
        alt="Latar Belakang Blog"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0e2207] to-transparent opacity-90"></div>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto">
      <div class="max-w-4xl text-left">
        <h1 class="text-5xl sm:text-7xl lg:text-[80px] font-semibold leading-tight tracking-tighter mb-6">
          Detail Blog
        </h1>
        <p class="max-w-lg text-lg text-gray-200">
          Temukan Kedalaman Penuh dari Konten dan Diskusi Blog Kami
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-10 lg:gap-16">
      <div class="lg:w-2/3">
        <article>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#0E2207] mb-4">{blog.title}</h2>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6 text-sm text-[#1f6306] font-semibold">
            <span>{blog.date}</span>
            <span class="text-gray-400">&bull;</span>
            <span>{blog.category}</span>
            <span class="text-gray-400">&bull;</span>
            <span>{blog.author}</span>
          </div>
          <img
            src={blog.imageUrl}
            alt={blog.title}
            class="w-full h-auto object-cover rounded-2xl aspect-video mb-8"
          />
          <div class="blog-content prose max-w-none text-gray-600" set:html={blog.content} />
        </article>
      </div>

      <aside class="lg:w-1/3">
        <div class="sticky top-28 space-y-8">
          <div class="bg-[#0e2207] rounded-2xl p-6">
            <span class="inline-block py-1 px-3 border border-[#FBC91A] rounded-full text-xs font-semibold text-[#FBC91A] mb-4">
              Blog &amp; Artikel Lainnya
            </span>
            <h3 class="text-2xl font-bold text-white mb-6">Jelajahi Blog Lain</h3>
            <div class="space-y-4">
              {otherBlogs.map((other) => (
                <a
                  href={`/blog/${other.href}`}
                  class="flex items-start gap-4 group pb-4 border-b border-[#fbc91a]/20 last:border-b-0"
                >
                  <img
                    src={other.imageUrl}
                    alt={other.title}
                    class="w-28 h-24 object-cover rounded-lg flex-shrink-0"
                  />
                  <div class="flex flex-col">
                    <span class="text-sm text-[#FBC91A] font-semibold mb-1">{other.date}</span>
                    <h4 class="text-base font-bold text-white group-hover:text-[#FBC91A] transition-colors leading-tight">
                      {other.title}
                    </h4>
                  </div>
                </a>
              ))}
            </div>
          </div>
          <div class="bg-[#1f6306] rounded-2xl p-8 text-center text-white">
            <span class="inline-block py-1 px-3 border border-[#FBC91A] rounded-full text-xs font-semibold text-[#FBC91A] mb-3">
              Get in touch
            </span>
            <h3 class="text-2xl font-bold mb-4">Solusi Inovatif untuk Pertanian</h3>
            <a
              href="/kontak"
              class="bg-[#fbc91a] text-[#0e2207] font-bold py-3 px-6 rounded-full hover:bg-white transition-colors inline-block"
            >
              Hubungi Sekarang
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
