---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection';
import ServicesSection from '../components/ServicesSection';
import AboutSection from '../components/AboutSection';
import CaseStudiesSection from '../components/CaseStudiesSection';
import TestimonialsSection from '../components/TestimonialsSection';
import FaqSection from '../components/FaqSection';
import BlogSection from '../components/BlogSection';
import { BLOG_POSTS, TESTIMONIALS } from '../constants.tsx';
---

<Layout
  title="Marketplace Barang Perikanan B2B Terpadu Indonesia"
  description="FisheryTrade adalah platform marketplace barang perikanan dan hasil laut terstandar untuk hotel, restoran, supermarket, dan distributor daerah langsung dari sentra gudang distribusi Muara Baru, Lamongan, dan Benoa."
>
  <HeroSection />
  <ServicesSection />
  <AboutSection />
  <CaseStudiesSection />
  <TestimonialsSection client:visible testimonials={TESTIMONIALS} />
  <FaqSection client:load />
  <BlogSection posts={BLOG_POSTS} />
</Layout>
