# FisheryTrade environment configuration template.
# Copy to apps/admin/.env.local and apps/web/.env.local; use real values only in ignored local files or deployment secrets.
# Never commit database URLs/passwords or real admin credentials.

# ==============================================================================
# Vercel Multi-Service Project Notes:
# - On Vercel, ADMIN_URL is automatically injected into the web service via the
#   service binding defined in vercel.json. Do NOT set ADMIN_URL manually in Vercel.
# ==============================================================================

# Admin server (apps/admin/.env.local)
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_WEB_URL=

# Public website (apps/web/.env.local)
# Used during standalone local dev (e.g. running apps separately without vercel dev)
PUBLIC_ADMIN_API_URL=http://localhost:4000
